{
  "name": "@reservas/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/operations/worker.ts",
    "worker:production": "node dist/operations/worker.js",
    "test:integration": "RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.0",
    "@reservas/shared": "workspace:*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "otplib": "^12.0.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7",
    "sharp": "0.35.5",
    "nodemailer": "10.2.1",
    "web-push": "^3.6.7",
    "ioredis": "^5.8.1",
    "@prisma/adapter-mariadb": "6.19.0",
    "express": "5.3.0",
    "bullmq": "^5.70.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9",
    "@types/nodemailer": "^7.0.1",
    "@types/multer": "^2.0.0",
    "@types/web-push": "^3.6.4",
    "ts-node": "^10.9.2",
    "smtp-server": "^3.16.1",
    "@types/smtp-server": "^3.5.13"
  }
}
