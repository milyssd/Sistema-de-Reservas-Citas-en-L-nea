# development enables Swagger; production requires HTTPS cookies and REDIS_URL.
NODE_ENV=development
# API TCP port; bind/firewall behind Nginx on the production server.
PORT=3001
# MySQL 8 or MariaDB URL. URL-encode username and password. Server-side only.
DATABASE_URL=mysql://reservas:CHANGE_ME@127.0.0.1:3306/reservas
# Public business for v1; authenticated requests derive tenant from their user.
BUSINESS_ID=11111111-1111-4111-8111-111111111111
# Generate at least 32 random characters; never expose in NEXT_PUBLIC variables.
JWT_SECRET=
# Exact browser origin, without trailing slash. Also the base for email links.
WEB_ORIGIN=http://localhost:3000
# Refresh session lifetime, in days.
AUTH_REFRESH_DAYS=30
# Optional 64 hexadecimal characters (32 random bytes); required to enable TOTP.
AUTH_ENCRYPTION_KEY=
# Exact trusted proxy socket IPs separated by commas; empty trusts no proxy.
TRUSTED_PROXY_IPS=
# Optional development / required production: shared rate limits across instances.
REDIS_URL=
# Optional prefix to isolate shared Redis counters between installations.
RATE_LIMIT_NAMESPACE=reservas:rate
# Admin created by seed only; existing passwords are never overwritten.
ADMIN_EMAIL=
# At least 12 characters, upper/lowercase and number. Never a repository default.
ADMIN_PASSWORD=
# Private storage path, resolved from apps/api; outside the web public directory.
STORAGE_PATH=../../storage
# Optional SMTP delivery. Without SMTP messages remain in durable outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional Web Push keys; generate once for production and keep private key private.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional Expo enhanced push security token; not needed for local login/list.
EXPO_ACCESS_TOKEN=

# Adaptive guest proof-of-work. Authenticated requests never require it.
# Free guest attempts (holds + new bookings) per IP in a 15-minute window.
GUEST_POW_AFTER=8
# Leading zero bits of SHA-256(token + ':' + decimalNonce), accepted range 12..22.
GUEST_POW_DIFFICULTY=16
# Signed challenge lifetime in seconds; accepted range 30..300.
GUEST_POW_TTL_SECONDS=120
