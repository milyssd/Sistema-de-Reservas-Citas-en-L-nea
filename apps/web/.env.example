# Public URL used by browsers. No secrets belong in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Canonical public web URL for sitemap, metadata and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only API base for server-rendered public catalog (optional).
API_INTERNAL_URL=http://127.0.0.1:3001/api/v1
