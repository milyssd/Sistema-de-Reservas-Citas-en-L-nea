# URL pública de la MISMA API consumida por la web. Nunca añadir secretos EXPO_PUBLIC_.
# En dispositivo físico usar la IP LAN del servidor durante desarrollo, no localhost.
# En producción debe ser HTTPS a través del dominio configurado en Cloudflare Tunnel.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api/v1
# ID público del proyecto Expo para registro push; no es un secreto.
# Push remoto necesita un development/release build y credenciales APNs/FCM del operador.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Ruta local al archivo Android FCM; mantenerlo fuera del repositorio.
# Sólo lo consume app.config.ts durante la compilación nativa.
GOOGLE_SERVICES_FILE=
