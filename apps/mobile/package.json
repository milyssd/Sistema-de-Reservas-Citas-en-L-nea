    "expo-status-bar": "~58.0.4",
    "expo-linking": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "expo-notifications": "~58.1.6",
    "expo-calendar": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-constants": "~58.0.13",
    "react-native-safe-area-context": "~5.10.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "5.9.3",
