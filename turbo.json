{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "BUSINESS_ID",
    "JWT_SECRET",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NODE_ENV",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_EAS_PROJECT_ID",
    "GOOGLE_SERVICES_FILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "@reservas/api-client#build": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "XDG_DATA_HOME",
    "XDG_CACHE_HOME",
    "pnpm_config_store_dir",
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "EXPO_NO_TELEMETRY",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
    "CI"
  ]
}
